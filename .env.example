# ── LLM Configuration (Phase 4) ─────────────────────────────────────────────
LLM_PROVIDER=openai                      # openai | anthropic | google
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=your_openai_api_key_here

# Uncomment the provider you want to switch to:
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# LLM_MODEL=claude-sonnet-4-6

# GOOGLE_API_KEY=your_google_api_key_here
# LLM_MODEL=gemini-2.0-flash

# ── Embeddings (Phase 2) ─────────────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small   # OpenAI embedding model

# ── Web Search — Tool 2 in MCP Server (Phase 3) ──────────────────────────────
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# ── Text-to-Speech (Phase 6) ─────────────────────────────────────────────────
TTS_PROVIDER=openai                      # openai | elevenlabs | coqui
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ── Kaggle — for downloading the dataset (Phase 1) ───────────────────────────
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key_here
